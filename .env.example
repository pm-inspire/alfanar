### Frontend (Vite)
# Nothing secret should be exposed to the browser.

### API (Node/Express) - used by `server/index.mjs`
OPENAI_API_KEY=
# Optional: override embedding model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# API port (default 8787)
AI_SEARCH_PORT=8787

# Toggle AI features (semantic embeddings). If false, server uses keyword+fuzzy only.
AI_SEARCH_ENABLED=true

# Admin endpoints protection (required for /api/admin/*)
ADMIN_TOKEN=change-me

# Data source
# For this repo demo, products are loaded from `server/data/products.sample.json`.
# In production, set MYSQL_* and implement the MySQL adapter.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
